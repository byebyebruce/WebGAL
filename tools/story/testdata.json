    "chapters": [
        {
            "title": "勇敢的王子",
            "scenes": [
                {
                    "location": "黑翼山脉的山脚",
                    "description": "山脚下，密林环绕，阴云笼罩，空气中弥漫着一股紧张的气氛。",
                    "time": "黄昏",
                    "dialogues": [
                        {
                            "role": "亚瑟王子",
                            "content": "我必须救出艾莉公主，无论前方有多么危险。",
                            "expression": "determined"
                        }
                    ]
                },
                {
                    "location": "黑翼山脉的恶龙巢穴",
                    "description": "巢穴深处，阴暗潮湿，岩壁上布满了青苔和藤蔓，空气中弥漫着龙息的炽热气味。",
                    "time": "夜晚",
                    "dialogues": [
                        {
                            "role": "艾莉公主",
                            "content": "救命！有人吗？",
                            "expression": "sad"
                        },
                        {
                            "role": "亚瑟王子",
                            "content": "艾莉，我来了！",
                            "expression": "determined"
                        },
                        {
                            "role": "恶龙",
                            "content": "哈哈哈，又一个不自量力的家伙。",
                            "expression": "angry"
                        }
                    ]
                }
            ]
        },
        {
            "title": "激烈的战斗",
            "scenes": [
                {
                    "location": "恶龙巢穴的中央",
                    "description": "中央宽敞的空间，地面上散落着许多宝石和金银财宝，恶龙盘踞在一旁，双眼紧盯着亚瑟王子。",
                    "time": "夜晚",
                    "dialogues": [
                        {
                            "role": "亚瑟王子",
                            "content": "我不会让你伤害艾莉的！",
                            "expression": "angry"
                        },
                        {
                            "role": "恶龙",
                            "content": "那就来试试吧！",
                            "expression": "angry"
                        }
                    ]
                }
            ]
        },
        {
            "title": "胜利与重逢",
            "scenes": [
                {
                    "location": "恶龙巢穴的中央",
                    "description": "恶龙倒在地上，亚瑟王子满身伤痕，但依然站立着，艾莉公主从角落里跑出来。",
                    "time": "夜晚",
                    "dialogues": [
                        {
                            "role": "艾莉公主",
                            "content": "亚瑟，你没事吧？",
                            "expression": "sad"
                        },
                        {
                            "role": "亚瑟王子",
                            "content": "我没事，艾莉。我们回家吧。",
                            "expression": "smile"
                        },
                        {
                            "role": "艾莉公主",
                            "content": "谢谢你，亚瑟。",
                            "expression": "smile"
                        }
                    ]
                }
            ]
        }
    ]
